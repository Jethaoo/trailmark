<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Trailmark.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Trailmark.ViewModels"
    x:DataType="vm:SettingsViewModel">
    <ContentPage.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Styles/Colors.xaml" /><ResourceDictionary Source="../Resources/Styles/Styles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,110" Spacing="0">
            <Label Text="Settings" Style="{StaticResource PageTitle}" HeightRequest="74" VerticalTextAlignment="Center" />

            <!-- MAP -->
            <Label Text="MAP" Style="{StaticResource Eyebrow}" TextColor="{AppThemeBinding Light={StaticResource SectionAccentLight}, Dark={StaticResource SectionAccentDark}}" Margin="4,10,0,7" />
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid Padding="14,10" ColumnDefinitions="*,Auto,20" ColumnSpacing="12" MinimumHeightRequest="60">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChooseMapStyleCommand}" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="Map style" Style="{StaticResource SettingsRowTitle}" />
                        <Label Text="{Binding MapStyle}" Style="{StaticResource BodyMuted}" FontSize="11" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="36" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource Accent}" VerticalOptions="Center" />
                    <Label Grid.Column="2" Style="{StaticResource Chevron}" />
                </Grid>
            </Border>

            <!-- UNITS -->
            <Label Text="UNITS" Style="{StaticResource Eyebrow}" TextColor="{AppThemeBinding Light={StaticResource SectionAccentLight}, Dark={StaticResource SectionAccentDark}}" Margin="4,23,0,7" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Grid Padding="14,10" ColumnDefinitions="*,Auto" MinimumHeightRequest="66">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="Distance" Style="{StaticResource SettingsRowTitle}" />
                            <Label Text="{Binding DistanceUnit}" Style="{StaticResource BodyMuted}" FontSize="11" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Padding="3" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="0">
                                <Button Text="km" WidthRequest="46" Style="{StaticResource SegmentButton}" Command="{Binding SetDistanceUnitCommand}" CommandParameter="km">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsDistanceKilometers}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="mi" WidthRequest="46" Style="{StaticResource SegmentButton}" Command="{Binding SetDistanceUnitCommand}" CommandParameter="mi">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsDistanceMiles}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                    <Grid Padding="14,10" ColumnDefinitions="*,Auto" MinimumHeightRequest="66">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="Elevation" Style="{StaticResource SettingsRowTitle}" />
                            <Label Text="{Binding ElevationUnit}" Style="{StaticResource BodyMuted}" FontSize="11" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Padding="3" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="0">
                                <Button Text="m" WidthRequest="46" Style="{StaticResource SegmentButton}" Command="{Binding SetElevationUnitCommand}" CommandParameter="m">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsElevationMeters}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="ft" WidthRequest="46" Style="{StaticResource SegmentButton}" Command="{Binding SetElevationUnitCommand}" CommandParameter="ft">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsElevationFeet}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- APPEARANCE -->
            <Label Text="APPEARANCE" Style="{StaticResource Eyebrow}" TextColor="{AppThemeBinding Light={StaticResource SectionAccentLight}, Dark={StaticResource SectionAccentDark}}" Margin="4,23,0,7" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Theme" Style="{StaticResource SettingsRowTitle}" />
                        <Label Grid.Column="1" Text="{Binding Theme}" Style="{StaticResource BodyMuted}" VerticalOptions="Center" />
                    </Grid>
                    <Border Padding="3" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}">
                        <Grid ColumnDefinitions="*,*,*">
                            <Button Text="System" Style="{StaticResource SegmentButton}" Command="{Binding SetThemeCommand}" CommandParameter="System">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsThemeSystem}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1" Text="Light" Style="{StaticResource SegmentButton}" Command="{Binding SetThemeCommand}" CommandParameter="Light">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsThemeLight}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="2" Text="Dark" Style="{StaticResource SegmentButton}" Command="{Binding SetThemeCommand}" CommandParameter="Dark">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsThemeDark}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Border>
                    <Label Text="Text, cards and the map chrome follow this setting." Style="{StaticResource BodyMuted}" FontSize="11" />
                </VerticalStackLayout>
            </Border>

            <!-- STORAGE -->
            <Label Text="STORAGE" Style="{StaticResource Eyebrow}" TextColor="{AppThemeBinding Light={StaticResource SectionAccentLight}, Dark={StaticResource SectionAccentDark}}" Margin="4,23,0,7" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,20" MinimumHeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowStorageCommand}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Local GPX files" Style="{StaticResource SettingsRowTitle}" />
                            <Label Text="{Binding StorageSummary}" Style="{StaticResource BodyMuted}" FontSize="11" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Style="{StaticResource Chevron}" />
                    </Grid>
                    <ProgressBar Progress="{Binding StorageFraction}" ProgressColor="{AppThemeBinding Light={StaticResource SectionAccentLight}, Dark={StaticResource SectionAccentDark}}" IsVisible="{Binding HasStorage}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <Grid ColumnDefinitions="*,20" MinimumHeightRequest="52">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowAboutCommand}" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="About Trailmark" Style="{StaticResource SettingsRowTitle}" />
                        <Label Text="Version 1.0.0 · Offline-first" Style="{StaticResource BodyMuted}" FontSize="11" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Style="{StaticResource Chevron}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
