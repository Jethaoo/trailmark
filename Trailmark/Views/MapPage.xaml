<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Trailmark.Views.MapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Trailmark.ViewModels"
    x:DataType="vm:MapViewModel">
    <ContentPage.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Styles/Colors.xaml" /><ResourceDictionary Source="../Resources/Styles/Styles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></ContentPage.Resources>

    <Grid>
        <WebView x:Name="MapWebView" Source="{Binding MapSource}" Navigated="OnMapNavigated" />

        <Grid VerticalOptions="Start" Margin="14,14,14,0" ColumnDefinitions="48,*,48" ColumnSpacing="10">
            <Button Text="‹" Style="{StaticResource IconButton}" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" FontSize="30" SemanticProperties.Description="Back" Command="{Binding BackCommand}" Shadow="{Shadow Brush=#22000000, Offset='0,3', Radius=8}" />
            <Border Grid.Column="1" HeightRequest="48" Padding="14,6" StrokeThickness="0" StrokeShape="RoundRectangle 15" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                    <Label Text="{Binding Name}" Style="{StaticResource Eyebrow}" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Distance}" FontSize="14" FontFamily="OpenSansSemibold" />
                </VerticalStackLayout>
            </Border>
            <Button Grid.Column="2" Text="•••" Style="{StaticResource IconButton}" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" SemanticProperties.Description="Map actions" Command="{Binding MoreCommand}" Shadow="{Shadow Brush=#22000000, Offset='0,3', Radius=8}" />
        </Grid>

        <VerticalStackLayout HorizontalOptions="End" VerticalOptions="End" Margin="0,0,14,250" Spacing="9">
            <Button Text="⌗" Style="{StaticResource IconButton}" CornerRadius="15" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" TextColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" SemanticProperties.Description="Zoom to track" Command="{Binding ZoomToTrackCommand}" Shadow="{Shadow Brush=#22000000, Offset='0,3', Radius=8}" />
            <Button Text="⌖" Style="{StaticResource IconButton}" CornerRadius="15" BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" TextColor="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" SemanticProperties.Description="Recenter on my location" Command="{Binding RecenterCommand}" Shadow="{Shadow Brush=#22000000, Offset='0,3', Radius=8}" />
        </VerticalStackLayout>

        <Border VerticalOptions="End" HeightRequest="{Binding SheetHeight}" Padding="20,0,20,22" StrokeThickness="0" StrokeShape="RoundRectangle 28,28,0,0" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" Shadow="{Shadow Brush=#33000000, Offset='0,-6', Radius=18}">
            <VerticalStackLayout Spacing="0">
                <Button Text="━" HeightRequest="30" Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" SemanticProperties.Description="Expand statistics" Command="{Binding ToggleSheetCommand}" />
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="ON TRACK" Style="{StaticResource Eyebrow}" TextColor="{AppThemeBinding Light={StaticResource SectionAccentLight}, Dark={StaticResource SectionAccentDark}}" />
                        <Label Text="{Binding Name}" FontSize="18" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Padding="8,5" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoftLight}, Dark={StaticResource AccentSoftDark}}" VerticalOptions="Center">
                        <Label Text="{Binding LocationStatus}" FontSize="9" FontFamily="OpenSansSemibold" TextColor="{AppThemeBinding Light={StaticResource OnAccentSoftLight}, Dark={StaticResource OnAccentSoftDark}}" />
                    </Border>
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,15,0,0">
                    <Border Padding="10,12" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}">
                        <VerticalStackLayout><Label Text="DISTANCE" Style="{StaticResource MetricLabel}" /><Label Text="{Binding Distance}" FontSize="18" FontFamily="OpenSansSemibold" /></VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="10,12" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}">
                        <VerticalStackLayout><Label Text="ASCENT" Style="{StaticResource MetricLabel}" /><Label Text="{Binding Ascent}" FontSize="18" FontFamily="OpenSansSemibold" /></VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Padding="10,12" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}">
                        <VerticalStackLayout><Label Text="DURATION" Style="{StaticResource MetricLabel}" /><Label Text="{Binding Duration}" FontSize="18" FontFamily="OpenSansSemibold" /></VerticalStackLayout>
                    </Border>
                </Grid>
                <VerticalStackLayout IsVisible="{Binding IsSheetExpanded}" Margin="0,15,0,0">
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                    <Grid Padding="2,12" ColumnDefinitions="*,Auto"><Label Text="Highest point" Style="{StaticResource BodyMuted}" FontSize="13" /><Label Grid.Column="1" Text="{Binding HighestPoint}" FontFamily="OpenSansSemibold" FontSize="13" /></Grid>
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                    <Grid Padding="2,12" ColumnDefinitions="*,Auto"><Label Text="Waypoints" Style="{StaticResource BodyMuted}" FontSize="13" /><Label Grid.Column="1" Text="{Binding WaypointCount}" FontFamily="OpenSansSemibold" FontSize="13" /></Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Border IsVisible="{Binding HasError}" Style="{StaticResource Card}" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="290" Padding="22">
            <VerticalStackLayout Spacing="10">
                <Label Text="Map unavailable" Style="{StaticResource StateTitle}" />
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource StateMessage}" />
                <Button Text="Go back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" />
            </VerticalStackLayout>
        </Border>
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{AppThemeBinding Light={StaticResource SectionAccentLight}, Dark={StaticResource SectionAccentDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
