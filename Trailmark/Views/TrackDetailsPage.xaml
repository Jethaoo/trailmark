<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Trailmark.Views.TrackDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Trailmark.Views.Controls"
    xmlns:vm="clr-namespace:Trailmark.ViewModels"
    x:DataType="vm:TrackDetailsViewModel"
    Shell.TabBarIsVisible="False">
    <ContentPage.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Styles/Colors.xaml" /><ResourceDictionary Source="../Resources/Styles/Styles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></ContentPage.Resources>

    <Grid>
        <ScrollView IsVisible="{Binding HasTrack}">
            <VerticalStackLayout Padding="20,12,20,36" Spacing="0">
                <Grid HeightRequest="74" ColumnDefinitions="52,*,44">
                    <Button Text="‹" Style="{StaticResource IconButton}" FontSize="34" Command="{Binding BackCommand}" />
                    <Label Grid.Column="1" Text="Track details" Style="{StaticResource PageTitle}" VerticalOptions="Center" />
                    <Button Grid.Column="2" Text="•••" Style="{StaticResource IconButton}" SemanticProperties.Description="Track actions" Command="{Binding MoreCommand}" />
                </Grid>

                <controls:RouteThumbnailView HeightRequest="185" Margin="-20,0" />

                <Grid ColumnDefinitions="7,*" ColumnSpacing="13" Margin="0,20">
                    <BoxView Color="{StaticResource Accent}" CornerRadius="4" />
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="{Binding ActivityAndDate}" TextColor="{AppThemeBinding Light={StaticResource SectionAccentLight}, Dark={StaticResource SectionAccentDark}}" FontSize="9" CharacterSpacing="1.3" FontFamily="OpenSansSemibold" />
                        <Label Text="{Binding Name}" FontSize="23" FontFamily="OpenSansSemibold" />
                        <Label Text="{Binding Location}" Style="{StaticResource BodyMuted}" />
                    </VerticalStackLayout>
                </Grid>

                <Button Text="⌖  View on map" Style="{StaticResource PrimaryButton}" Command="{Binding ViewMapCommand}" />

                <Border Style="{StaticResource Card}" Padding="0" Margin="0,14" StrokeShape="RoundRectangle 18">
                    <Grid RowDefinitions="Auto,1,Auto" ColumnDefinitions="*,1,*">
                        <VerticalStackLayout Padding="15" Spacing="4"><Label Text="DISTANCE" Style="{StaticResource MetricLabel}" /><Label Text="{Binding Distance}" FontSize="18" FontFamily="OpenSansSemibold" /></VerticalStackLayout>
                        <BoxView Grid.Column="1" Grid.RowSpan="3" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        <VerticalStackLayout Grid.Column="2" Padding="15" Spacing="4"><Label Text="DURATION" Style="{StaticResource MetricLabel}" /><Label Text="{Binding Duration}" FontSize="18" FontFamily="OpenSansSemibold" /></VerticalStackLayout>
                        <BoxView Grid.Row="1" Grid.ColumnSpan="3" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        <VerticalStackLayout Grid.Row="2" Padding="15" Spacing="4"><Label Text="GAIN / LOSS" Style="{StaticResource MetricLabel}" /><Label Text="{Binding GainLoss}" FontSize="18" FontFamily="OpenSansSemibold" /></VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="2" Grid.Column="2" Padding="15" Spacing="4"><Label Text="AVG. SPEED" Style="{StaticResource MetricLabel}" /><Label Text="{Binding AverageSpeed}" FontSize="18" FontFamily="OpenSansSemibold" /></VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto"><Label Text="Elevation" Style="{StaticResource SectionTitle}" /><Label Grid.Column="1" Text="{Binding HighestElevation}" Style="{StaticResource BodyMuted}" FontSize="11" VerticalOptions="Center" /></Grid>
                        <controls:ElevationProfileView HeightRequest="110" Values="{Binding ElevationValues}" />
                        <Grid ColumnDefinitions="*,Auto"><Label Text="{Binding LowestElevation}" Style="{StaticResource BodyMuted}" FontSize="10" /><Label Grid.Column="1" Text="{Binding Distance}" Style="{StaticResource BodyMuted}" FontSize="10" /></Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,14,0,0">
                    <Button Text="↗  Share GPX" Style="{StaticResource SecondaryButton}" Command="{Binding ShareCommand}" />
                    <Button Grid.Column="1" Text="Delete" Style="{StaticResource SecondaryButton}" TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" Command="{Binding DeleteCommand}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout IsVisible="{Binding HasError}" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="280" Spacing="10">
            <Label Text="Track unavailable" Style="{StaticResource StateTitle}" />
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource StateMessage}" />
            <Button Text="Go back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" />
        </VerticalStackLayout>
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{AppThemeBinding Light={StaticResource SectionAccentLight}, Dark={StaticResource SectionAccentDark}}" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
