<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Trailmark.Views.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Trailmark.Views"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
    Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
    Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">
    <Shell.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="../Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Shell.Resources>

    <TabBar>
        <ShellContent Route="home" Title="Home" ContentTemplate="{DataTemplate views:HomePage}">
            <ShellContent.Icon><FontImageSource Glyph="⌂" Color="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" Size="22" /></ShellContent.Icon>
        </ShellContent>
        <ShellContent Route="library" Title="Tracks" ContentTemplate="{DataTemplate views:TrackLibraryPage}">
            <ShellContent.Icon><FontImageSource Glyph="☷" Color="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" Size="22" /></ShellContent.Icon>
        </ShellContent>
        <ShellContent Route="map-tab" Title="Map" ContentTemplate="{DataTemplate views:MapPage}">
            <ShellContent.Icon><FontImageSource Glyph="⌖" Color="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" Size="22" /></ShellContent.Icon>
        </ShellContent>
        <ShellContent Route="settings" Title="Settings" ContentTemplate="{DataTemplate views:SettingsPage}">
            <ShellContent.Icon><FontImageSource Glyph="⚙" Color="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" Size="22" /></ShellContent.Icon>
        </ShellContent>
    </TabBar>
</Shell>
